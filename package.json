{
  "name": "new-york-life",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:convex": "convex dev",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=packages/game-core",
    "typecheck": "tsc -p packages/game-core && tsc -p packages/content && tsc -p convex && npm run typecheck --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
